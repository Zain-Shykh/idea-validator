# Copy to .env and fill in. NEVER commit .env. Names only here (GEN-4, LOC-3).
# Kubernetes Secrets are created from this file by scripts/create_secrets.sh.

# --- External API keys (mounted ONLY into the tools / M5 pod) ---
GEMINI_API_KEY=
GITHUB_TOKEN=
PRODUCTHUNT_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Postgres (one instance, databases: app, kb, ops) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ideaval
POSTGRES_PASSWORD=
APP_DB=app
KB_DB=kb
OPS_DB=ops

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Gateway auth ---
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# --- LLM routing ---
# gateway = via M5 /llm/chat (k8s) | direct = LiteLLM from the service (local dev) | fake = cassettes (tests)
LLM_BACKEND=direct
# fake backend only: JSONL file of recorded replies
LLM_CASSETTE_PATH=
# direct backend only: provider model behind each alias (leave unset for the defaults in common.settings)
# LLM_MODEL_AGENT_DEFAULT=
# LLM_MODEL_AGENT_CHEAP=
# LLM_MODEL_SCORER_HOSTED=
# LLM_MODEL_LOCAL_DEV=
OLLAMA_BASE_URL=http://host.docker.internal:11434
# llamacpp (k8s) | ollama (local dev) | hosted (comparison runs)
SCORER_BACKEND=ollama

# --- Internal service URLs (in k8s: http://<service>:8000) ---
GATEWAY_URL=http://gateway:8000
PROFILE_URL=http://profile:8000
ORCHESTRATOR_URL=http://orchestrator:8000
SCOUTS_URL=http://scouts:8000
TOOLS_URL=http://tools:8000
KB_URL=http://kb:8000
ANALYST_URL=http://analyst:8000
IDEATION_URL=http://ideation:8000
VALIDATORS_URL=http://validators:8000
SCORER_URL=http://scorer:8000
VERDICT_URL=http://verdict:8000
CRITIC_URL=http://critic:8000
AGENTOPS_URL=http://agentops:8000

# --- UI runtime config (M1-2) ---
UI_API_BASE_URL=/api

# --- Docker Compose only (optional overrides) ---
# image tag, normally the short git SHA: IMAGE_TAG=$(git rev-parse --short HEAD)
IMAGE_TAG=
# host ports, if 5432 / 6379 are taken
POSTGRES_HOST_PORT=
REDIS_HOST_PORT=

# --- Registry / CI ---
GHCR_OWNER=zain-shykh
LOG_LEVEL=INFO
