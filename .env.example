# Copy to .env and fill in. NEVER commit .env. Names only here (GEN-4, LOC-3).
# Kubernetes Secrets are created from this file by scripts/create_secrets.sh.

# --- External API keys (mounted ONLY into the tools / M5 pod) ---
GEMINI_API_KEY=
GITHUB_TOKEN=
PRODUCTHUNT_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Postgres (one instance, databases: app, kb, ops) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ideaval
POSTGRES_PASSWORD=
APP_DB=app
KB_DB=kb
OPS_DB=ops

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Gateway auth ---
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# --- LLM routing ---
# gateway = via M5 /llm/chat (k8s) | direct = LiteLLM from the service (local dev) | fake = cassettes (tests)
LLM_BACKEND=direct
# fake backend only: JSONL file of recorded replies
LLM_CASSETTE_PATH=
# direct backend only: provider model behind each alias (leave unset for the defaults in common.settings)
# LLM_MODEL_AGENT_DEFAULT=
# LLM_MODEL_AGENT_CHEAP=
# LLM_MODEL_SCORER_HOSTED=
# LLM_MODEL_LOCAL_DEV=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- M10 scorer ---
# llamacpp (k8s) | ollama (local dev) | hosted (comparison runs)
SCORER_BACKEND=ollama
# llamacpp only: address of the llama.cpp server (the sidecar in k8s)
# SCORER_MODEL_URL=
# model name sent to the local server, and the model id recorded on its scores
# SCORER_LOCAL_MODEL=qwen2.5:1.5b
# SCORER_MODEL_ID=scorer-base@v1
# deadlines in seconds: both local attempts together, then the hosted fallback
# SCORER_LOCAL_TIMEOUT_S=60
# SCORER_HOSTED_TIMEOUT_S=25
# seconds between readiness probes until the model first answers
# SCORER_PROBE_INTERVAL_S=5
# local defaults are the repo folders (images use /etc/rubrics and /etc/prompts)
# SCORER_RUBRICS_DIR=
# SCORER_PROMPTS_DIR=

# --- Internal service URLs (in k8s: http://<service>:8000) ---
GATEWAY_URL=http://gateway:8000
PROFILE_URL=http://profile:8000
ORCHESTRATOR_URL=http://orchestrator:8000
SCOUTS_URL=http://scouts:8000
TOOLS_URL=http://tools:8000
KB_URL=http://kb:8000
ANALYST_URL=http://analyst:8000
IDEATION_URL=http://ideation:8000
VALIDATORS_URL=http://validators:8000
SCORER_URL=http://scorer:8000
VERDICT_URL=http://verdict:8000
CRITIC_URL=http://critic:8000
AGENTOPS_URL=http://agentops:8000

# --- UI runtime config (M1-2) ---
UI_API_BASE_URL=/api

# --- Docker Compose only (optional overrides) ---
# image tag, normally the short git SHA: IMAGE_TAG=$(git rev-parse --short HEAD)
IMAGE_TAG=
# host ports, if 5432 / 6379 are taken
POSTGRES_HOST_PORT=
REDIS_HOST_PORT=

# --- M3 orchestrator (also reads the service URLs above, REDIS_*, AGENTOPS_URL) ---
# which of "profile" and "verdict" must be ready before the pod takes traffic
# ORCH_READY_REQUIRES=profile,verdict
# model id of the primary scorer (equal to SCORER_MODEL_ID of M10); only its scores are cached
# SCORER_MODEL_ID=scorer-base@v1
# seconds: one scorer call with its retries (max 600); how long a run waits for the student
# ORCH_SCORER_TIMEOUT_S=600
# ORCH_WAIT_TIMEOUT_S=86400
# evidence search size (max 20); deep search size, estimated cost per page, scout sources
# ORCH_SEARCH_K=20
# ORCH_DEEP_SEARCH_PAGES=15
# ORCH_DEEP_SEARCH_PAGE_COST_USD=0.0005
# ORCH_SCOUT_SOURCES=hackernews,github
# Discover (needs ANALYST_URL): survivors the debate aims for, children validated at once, and
# the search similarity (0..1) from which a same-customer product is a renamed copy
# ORCH_DISCOVER_TARGET=5
# ORCH_DISCOVER_CONCURRENCY=2
# ORCH_DUPLICATE_SIMILARITY=0.9
# local defaults are the repo files (images use /etc/rubrics, /etc/prompts, /etc/budgets)
# ORCH_RUBRICS_DIR=
# ORCH_PROMPTS_DIR=
# ORCH_BUDGETS_PATH=

# --- M8 ideation (also reads KB_URL, TOOLS_URL, LLM_BACKEND, AGENTOPS_URL) ---
# passages the gap analyst retrieves per idea; seconds for one knowledge-base call
# IDEATION_SEARCH_K=8
# IDEATION_KB_TIMEOUT_S=10
# seconds: one agent call with its repair retry (max 60)
# IDEATION_LLM_TIMEOUT_S=50
# local default is the repo folder (the image uses /etc/prompts)
# IDEATION_PROMPTS_DIR=

# --- M9 validators (also reads KB_URL, ANALYST_URL, SCORER_URL, TOOLS_URL, LLM_BACKEND) ---
# model-scorer calls in flight: 1 suits one CPU model; raise it when M10 has more slots
# VALIDATORS_SCORER_CONCURRENCY=1
# seconds: one scorer call (max 90), then one whole request including the wait (below 600)
# VALIDATORS_SCORER_TIMEOUT_S=90
# VALIDATORS_DEADLINE_S=570
# VALIDATORS_KB_TIMEOUT_S=10
# VALIDATORS_EFFORT_TIMEOUT_S=20
# bounds on retrieval and on what is sent to the model
# VALIDATORS_SEARCH_K=20
# VALIDATORS_MAX_EVIDENCE=4
# VALIDATORS_MAX_QUOTE_CHARS=300
# VALIDATORS_MAX_IDEA_CHARS=1200
# similarity thresholds (0..1); re-tune on the real knowledge base
# VALIDATORS_MIN_SIMILARITY=0.2
# VALIDATORS_COMPETITOR_SIMILARITY=0.75
# VALIDATORS_DUPLICATE_SIMILARITY=0.9
# local defaults are the repo folders (images use /etc/rubrics and /etc/prompts)
# VALIDATORS_RUBRICS_DIR=
# VALIDATORS_PROMPTS_DIR=

# --- M12 critic (also reads KB_URL, TOOLS_URL, LLM_BACKEND, AGENTOPS_URL) ---
# seconds: one claim judgement (max 60), then all judgements of one request; one M6 call
# CRITIC_JUDGE_TIMEOUT_S=30
# CRITIC_DEADLINE_S=120
# CRITIC_KB_TIMEOUT_S=10
# longest idea text the input rail accepts
# CRITIC_MAX_INPUT_CHARS=5000
# local defaults are the repo files (images use /etc/prompts and /etc/budgets/budgets.yaml)
# CRITIC_PROMPTS_DIR=
# CRITIC_BUDGETS_PATH=

# --- M11 verdict ---
# rules file; unset = config/verdict.yaml from the repo root (images use /etc/verdict/verdict.yaml)
# VERDICT_CONFIG_PATH=

# --- M13 agentops ---
# local defaults are the repo folders and ./traces (images set the volume and ConfigMap paths)
# AGENTOPS_TRACES_DIR=
# AGENTOPS_RUBRICS_DIR=
# AGENTOPS_PROMPTS_DIR=
# AGENTOPS_CONFIG_DIR=
# full database URL; unset = built from POSTGRES_* and OPS_DB above
# AGENTOPS_DATABASE_URL=
# tests only: a throwaway database whose name ends in _test (it is dropped)
# AGENTOPS_TEST_DATABASE_URL=

# --- Registry / CI ---
GHCR_OWNER=zain-shykh
LOG_LEVEL=INFO
