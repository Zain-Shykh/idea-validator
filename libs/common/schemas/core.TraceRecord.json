{
  "$defs": {
    "TraceKind": {
      "enum": [
        "tool_call",
        "llm_call",
        "decision"
      ],
      "title": "TraceKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "DATA-6. One per agent step, tool call, model call and orchestrator decision.",
  "properties": {
    "agent": {
      "minLength": 1,
      "title": "Agent",
      "type": "string"
    },
    "cache_hit": {
      "default": false,
      "title": "Cache Hit",
      "type": "boolean"
    },
    "cost_usd": {
      "default": 0,
      "minimum": 0,
      "title": "Cost Usd",
      "type": "number"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "input": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input"
    },
    "kind": {
      "$ref": "#/$defs/TraceKind"
    },
    "latency_ms": {
      "default": 0,
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "output": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output"
    },
    "parent_step": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Step"
    },
    "prompt_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Version"
    },
    "retries": {
      "default": 0,
      "minimum": 0,
      "title": "Retries",
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "step_id": {
      "minimum": 0,
      "title": "Step Id",
      "type": "integer"
    },
    "tokens_in": {
      "default": 0,
      "minimum": 0,
      "title": "Tokens In",
      "type": "integer"
    },
    "tokens_out": {
      "default": 0,
      "minimum": 0,
      "title": "Tokens Out",
      "type": "integer"
    },
    "tool": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "step_id",
    "agent",
    "kind",
    "ts"
  ],
  "title": "TraceRecord",
  "type": "object"
}
