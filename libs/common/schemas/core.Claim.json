{
  "$defs": {
    "Dimension": {
      "description": "The six dimensions. Declaration order is the fixed iteration order of the engine.",
      "enum": [
        "demand_pain",
        "competition",
        "differentiation",
        "feasibility",
        "risk",
        "learning"
      ],
      "title": "Dimension",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "minLength": 1,
      "title": "Claim Id",
      "type": "string"
    },
    "dimension": {
      "anyOf": [
        {
          "$ref": "#/$defs/Dimension"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence_ids": {
      "items": {
        "pattern": "^card_[A-Za-z0-9]+#c\\d+$",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "text": {
      "minLength": 1,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "claim_id",
    "text",
    "evidence_ids"
  ],
  "title": "Claim",
  "type": "object"
}
