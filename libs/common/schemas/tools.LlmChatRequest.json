{
  "$defs": {
    "ChatMessage": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "ChatMessage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent": {
      "minLength": 1,
      "title": "Agent",
      "type": "string"
    },
    "max_tokens": {
      "default": 1024,
      "minimum": 1,
      "title": "Max Tokens",
      "type": "integer"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/ChatMessage"
      },
      "minItems": 1,
      "title": "Messages",
      "type": "array"
    },
    "model_alias": {
      "minLength": 1,
      "title": "Model Alias",
      "type": "string"
    },
    "response_format": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Format"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "temperature": {
      "default": 0.0,
      "maximum": 2,
      "minimum": 0,
      "title": "Temperature",
      "type": "number"
    }
  },
  "required": [
    "run_id",
    "agent",
    "model_alias",
    "messages"
  ],
  "title": "LlmChatRequest",
  "type": "object"
}
