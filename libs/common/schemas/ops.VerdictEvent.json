{
  "$defs": {
    "VerdictLabel": {
      "enum": [
        "GO",
        "PIVOT",
        "NO-GO",
        "INSUFFICIENT_EVIDENCE"
      ],
      "title": "VerdictLabel",
      "type": "string"
    },
    "Versions": {
      "additionalProperties": false,
      "description": "Versions recorded on every verdict (AO-3, architecture \u00a78.5).",
      "properties": {
        "engine": {
          "minLength": 1,
          "title": "Engine",
          "type": "string"
        },
        "kb_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kb Version"
        },
        "profile_weights": {
          "minLength": 1,
          "title": "Profile Weights",
          "type": "string"
        },
        "prompts": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Prompts",
          "type": "object"
        },
        "rubrics": {
          "minLength": 1,
          "title": "Rubrics",
          "type": "string"
        }
      },
      "required": [
        "engine",
        "rubrics",
        "profile_weights"
      ],
      "title": "Versions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "idea_id": {
      "minLength": 1,
      "title": "Idea Id",
      "type": "string"
    },
    "verdict": {
      "$ref": "#/$defs/VerdictLabel"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "versions": {
      "$ref": "#/$defs/Versions"
    }
  },
  "required": [
    "idea_id",
    "version",
    "verdict",
    "versions"
  ],
  "title": "VerdictEvent",
  "type": "object"
}
