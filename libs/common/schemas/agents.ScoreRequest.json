{
  "$defs": {
    "EvidenceItem": {
      "additionalProperties": false,
      "description": "DATA-3. ``evidence_id`` is ``<card_id>#c<n>``.",
      "properties": {
        "card_id": {
          "pattern": "^card_[A-Za-z0-9]+$",
          "title": "Card Id",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^card_[A-Za-z0-9]+#c\\d+$",
          "title": "Evidence Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "format": "date-time",
              "type": "string"
            }
          ],
          "title": "Retrieved At"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "card_id",
        "quote",
        "source",
        "url",
        "retrieved_at"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "IdeaInput": {
      "additionalProperties": false,
      "description": "The text of an idea, as given to agents.",
      "properties": {
        "text": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "text"
      ],
      "title": "IdeaInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "API-I3: rubric, idea, evidence in; ``DimensionScore`` out.",
  "properties": {
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceItem"
      },
      "title": "Evidence",
      "type": "array"
    },
    "features": {
      "additionalProperties": true,
      "title": "Features",
      "type": "object"
    },
    "idea": {
      "$ref": "#/$defs/IdeaInput"
    },
    "rubric_id": {
      "pattern": "^[a-z_]+@v\\d+$",
      "title": "Rubric Id",
      "type": "string"
    }
  },
  "required": [
    "rubric_id",
    "idea",
    "evidence"
  ],
  "title": "ScoreRequest",
  "type": "object"
}
