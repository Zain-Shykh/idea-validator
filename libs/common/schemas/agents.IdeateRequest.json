{
  "$defs": {
    "Compute": {
      "enum": [
        "laptop",
        "free_gpu",
        "paid"
      ],
      "title": "Compute",
      "type": "string"
    },
    "Dimension": {
      "description": "The six dimensions. Declaration order is the fixed iteration order of the engine.",
      "enum": [
        "demand_pain",
        "competition",
        "differentiation",
        "feasibility",
        "risk",
        "learning"
      ],
      "title": "Dimension",
      "type": "string"
    },
    "EvidenceItem": {
      "additionalProperties": false,
      "description": "DATA-3. ``evidence_id`` is ``<card_id>#c<n>``.",
      "properties": {
        "card_id": {
          "pattern": "^card_[A-Za-z0-9]+$",
          "title": "Card Id",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^card_[A-Za-z0-9]+#c\\d+$",
          "title": "Evidence Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "format": "date-time",
              "type": "string"
            }
          ],
          "title": "Retrieved At"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "card_id",
        "quote",
        "source",
        "url",
        "retrieved_at"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "GapContext": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "niche_id": {
          "minLength": 1,
          "title": "Niche Id",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "niche_id",
        "statement",
        "evidence"
      ],
      "title": "GapContext",
      "type": "object"
    },
    "Goal": {
      "enum": [
        "startup",
        "portfolio",
        "course_project"
      ],
      "title": "Goal",
      "type": "string"
    },
    "NicheContext": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "niche_id": {
          "minLength": 1,
          "title": "Niche Id",
          "type": "string"
        },
        "trend_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trend Label"
        }
      },
      "required": [
        "niche_id",
        "name"
      ],
      "title": "NicheContext",
      "type": "object"
    },
    "Objection": {
      "additionalProperties": false,
      "description": "A Skeptic objection. May be unsupported until the critic checks it.",
      "properties": {
        "dimension": {
          "$ref": "#/$defs/Dimension"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^card_[A-Za-z0-9]+#c\\d+$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "fatal": {
          "default": false,
          "title": "Fatal",
          "type": "boolean"
        },
        "idea_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idea Id"
        },
        "objection_id": {
          "minLength": 1,
          "title": "Objection Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "objection_id",
        "dimension",
        "text",
        "evidence_ids"
      ],
      "title": "Objection",
      "type": "object"
    },
    "StudentProfile": {
      "additionalProperties": false,
      "description": "DATA-2. ``version`` increases on every profile change and is part of cache keys.",
      "properties": {
        "compute": {
          "$ref": "#/$defs/Compute"
        },
        "goal": {
          "$ref": "#/$defs/Goal"
        },
        "hours_per_week": {
          "maximum": 168,
          "minimum": 0,
          "title": "Hours Per Week",
          "type": "integer"
        },
        "interests": {
          "items": {
            "type": "string"
          },
          "title": "Interests",
          "type": "array"
        },
        "skills": {
          "items": {
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "team_size": {
          "minimum": 1,
          "title": "Team Size",
          "type": "integer"
        },
        "user_id": {
          "minLength": 1,
          "title": "User Id",
          "type": "string"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "weeks_available": {
          "minimum": 1,
          "title": "Weeks Available",
          "type": "integer"
        }
      },
      "required": [
        "user_id",
        "skills",
        "hours_per_week",
        "weeks_available",
        "team_size",
        "compute",
        "goal",
        "interests"
      ],
      "title": "StudentProfile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "gaps": {
      "items": {
        "$ref": "#/$defs/GapContext"
      },
      "title": "Gaps",
      "type": "array"
    },
    "niches": {
      "items": {
        "$ref": "#/$defs/NicheContext"
      },
      "title": "Niches",
      "type": "array"
    },
    "prior_objections": {
      "items": {
        "$ref": "#/$defs/Objection"
      },
      "title": "Prior Objections",
      "type": "array"
    },
    "profile": {
      "$ref": "#/$defs/StudentProfile"
    },
    "round": {
      "description": "debate is bounded (M8-2)",
      "maximum": 3,
      "minimum": 1,
      "title": "Round",
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "profile",
    "niches",
    "gaps",
    "round"
  ],
  "title": "IdeateRequest",
  "type": "object"
}
